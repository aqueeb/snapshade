{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapshade",
  "version": "0.1.0",
  "identifier": "io.github.aqueeb.snapshade",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: print: http://print.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost frame: http://frame.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "Syed Aqueeb Qadri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": null
    }
  }
}
